# ============================================================
# LLM Engineering — Environment Configuration
# Copy this file to .env and fill in your values:
#   cp env/.env.template env/.env
# Never commit env/.env to git.
# ============================================================

# -------------------------------------------------------
# HuggingFace
# -------------------------------------------------------
HUGGINGFACE_HUB_TOKEN=hf_your_token_here

# -------------------------------------------------------
# Workspace paths (default: /workspace)
# -------------------------------------------------------
WORKSPACE=/workspace
PROJECT_DIR=/workspace/LLM_Engineering
HF_MODELS_DIR=/workspace/hf_models
TRT_ENGINE_DIR=/workspace/trt_engine
TRT_CKPT_DIR=/workspace/trt_ckpt
RESULTS_DIR=/workspace/LLM_Engineering/results

# -------------------------------------------------------
# CUDA
# -------------------------------------------------------
CUDA_VISIBLE_DEVICES=0
PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:512

# -------------------------------------------------------
# HuggingFace cache
# -------------------------------------------------------
HF_HOME=/workspace/.cache/huggingface
TRANSFORMERS_CACHE=/workspace/.cache/huggingface/transformers
HF_DATASETS_CACHE=/workspace/.cache/huggingface/datasets

# -------------------------------------------------------
# Python virtual environments
# -------------------------------------------------------
VENV_HF=/workspace/.venv_hf
VENV_VLLM=/workspace/.venv_vllm
VENV_SERVING=/workspace/.venv_serving

# -------------------------------------------------------
# Benchmark defaults
# -------------------------------------------------------
BATCH_SIZES=1,2,4,8
MAX_NEW_TOKENS=512
PROMPTS_FILE=/workspace/LLM_Engineering/prompts/prompts_mid.txt
